# Copy to .env.local and fill in. Never commit real values.

# MongoDB connection. Local: run `pnpm db:local` and use the value below.
# Production (Cloudflare): a MongoDB Atlas URI stored as an encrypted secret.
MONGODB_URI=mongodb://127.0.0.1:27017/couponkodee

# Random string, 32+ chars. Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin account created by `pnpm seed`. If the password is empty,
# a random one is generated and printed once.
SEED_ADMIN_EMAIL=admin@couponkodee.com
SEED_ADMIN_PASSWORD=

# Optional: extra comma-separated hosts /out may redirect to
# (affiliate networks such as linksredirect.com). Store hosts are allowed automatically.
OUTBOUND_ALLOWED_HOSTS=

# Optional: GA4 measurement ID (defaults to the CouponKodee production stream)
NEXT_PUBLIC_GA_ID=
