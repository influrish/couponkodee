{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "couponkodee",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Deploys from GitHub would otherwise delete variables set in the dashboard.
  "keep_vars": true,
  "vars": {
    // CMS server on Render (admin, API, database). See DEPLOY.md.
    "CMS_URL": "https://couponkodee.onrender.com"
  }
}
